# Delta Algo Backend Configuration

# FastAPI
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true

# Delta Exchange API
DELTA_BASE_URL=https://api.india.delta.exchange
DELTA_WS_URL=wss://public-socket.india.delta.exchange

# Market Data Mode
MARKET_DATA_MODE=REAL

# Persistent SQLite database for engine state and paper trading records
DATABASE_PATH=data/crypto_algo.db

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
