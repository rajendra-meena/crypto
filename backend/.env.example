# Phase 2: Delta Exchange Public Market Data Integration
# Backend Configuration

# FastAPI
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true

# Delta Exchange API
DELTA_BASE_URL=https://api.india.delta.exchange
DELTA_WS_URL=wss://api.india.delta.exchange/v2/websocket

# Market Data Mode
MARKET_DATA_MODE=REAL

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json